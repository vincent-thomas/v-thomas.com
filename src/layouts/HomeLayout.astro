---
import SiteLayout from './SiteLayout.astro';
interface Props {
  title: string;
  description: string;
  lastUpdated: string;
}
const { title, description, lastUpdated } = Astro.props;
---

<SiteLayout title={title} description={description}>
    <main>
      <div class="home-copy">
        <slot />
      </div>
      <footer>
        <p class="stamp"><span aria-hidden="true">&lt;!-- </span>Updated <time datetime={lastUpdated}>{lastUpdated}</time><span aria-hidden="true"> --&gt;</span></p>
      </footer>
    </main>
    <script>
      // Keep the email address out of the static HTML, then restore a native mailto link.
      const emailLink = document.querySelector('[data-email-user]');
      if (emailLink instanceof HTMLAnchorElement) {
        const reverse = (value: string) => [...value].reverse().join('');
        const user = reverse(emailLink.dataset.emailUser ?? '');
        const host = reverse(emailLink.dataset.emailHost ?? '');
        emailLink.href = `mailto:${user}@${host}`;
        delete emailLink.dataset.emailUser;
        delete emailLink.dataset.emailHost;
      }
    </script>
</SiteLayout>

<style>
  .home-copy :global(h1)::before {
    content: "# ";
    color: #888;
    font-weight: 400;
  }
  .home-copy :global(nav p) { display: contents; }
  .home-copy :global(.portrait-frame p) { margin: 0; height: 100%; }
  .home-copy :global(.portrait-frame img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.2) translate(-8%, -7%);
  }
  .home-copy :global(h2 a)::before {
    content: "## ";
    color: #888;
    font-weight: 400;
  }
</style>
