---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postUrl, getPosts } from '../lib/posts';
interface Props {
  posts?: CollectionEntry<'posts'>[];
  limit?: number;
}
const { posts = await getPosts(), limit } = Astro.props;
const visiblePosts = limit === undefined ? posts : posts.slice(0, limit);
---

{posts.length ? (
  <ul class="post-list">
    {visiblePosts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <div>
          <a href={postUrl(post.id)}>{post.data.title}</a>
          {post.data.draft && <span class="draft-label">Draft</span>}
          <p>{post.data.description}</p>
        </div>
      </li>
    ))}
  </ul>
) : <p class="empty-posts">No posts yet.</p>}
