---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postUrl } from '../lib/posts';
interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
---

{posts.length ? (
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <div>
          <a href={postUrl(post.id)}>{post.data.title}</a>
          {post.data.draft && <span class="draft-label">Draft</span>}
          <p>{post.data.description}</p>
        </div>
      </li>
    ))}
  </ul>
) : <p class="empty-posts">No posts yet.</p>}
